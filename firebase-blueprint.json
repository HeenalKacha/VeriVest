{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing full name, contact, email, age, gender, and audit timestamps",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["fullName", "email", "gender", "createdAt"]
    },
    "LearningProgress": {
      "title": "LearningProgress",
      "description": "Investor safety simulator progress and badge status",
      "type": "object",
      "properties": {
        "points": { "type": "integer" },
        "correctAnswers": { "type": "integer" },
        "completedQuestions": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "completed": { "type": "boolean" },
        "badgeEarned": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["points", "correctAnswers", "completedQuestions", "totalQuestions", "completed", "badgeEarned"]
    },
    "ScanHistoryRecord": {
      "title": "ScanHistoryRecord",
      "description": "Stored historical scan record with risk assessment and indicators",
      "type": "object",
      "properties": {
        "scanType": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "result": { "type": "string", "maxLength": 200 },
        "riskLevel": { "type": "string", "maxLength": 50 },
        "riskIndicators": { "type": "array" },
        "summary": { "type": "string", "maxLength": 10000 }
      },
      "required": ["scanType", "createdAt", "result", "riskLevel", "summary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile document"
    },
    "/users/{userId}/learning/progress": {
      "schema": { "$ref": "#/entities/LearningProgress" },
      "description": "User learning and simulator progress record"
    },
    "/users/{userId}/scanHistory/{scanId}": {
      "schema": { "$ref": "#/entities/ScanHistoryRecord" },
      "description": "User historical scan documents"
    }
  }
}
