rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return ((data.keys().hasAll(['fullName', 'email', 'gender', 'createdAt'])
          && data.fullName is string && data.fullName.size() <= 100
          && data.email is string && data.email.size() <= 150
          && data.gender in ['Male', 'Female']
          && (!('contact' in data) || (data.contact is string && data.contact.size() <= 30))
          && (!('age' in data) || data.age is number)
          && (!('updatedAt' in data) || data.updatedAt is string)
          && data.createdAt is string)
        || (data.keys().hasAll(['name', 'email', 'gender', 'createdAt'])
          && data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 150
          && data.gender in ['Male', 'Female']
          && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 30))
          && (!('age' in data) || data.age is number)
          && data.createdAt is string));
    }

    function isValidLearningProgress(data) {
      return data.keys().hasAll(['completedQuestions', 'correctAnswers'])
        && data.completedQuestions is number
        && data.correctAnswers is number
        && (!('points' in data) || data.points is number)
        && (!('score' in data) || data.score is number)
        && (!('totalQuestions' in data) || data.totalQuestions is number)
        && (!('completed' in data) || data.completed is bool)
        && (!('isCompleted' in data) || data.isCompleted is bool)
        && (!('badgeEarned' in data) || data.badgeEarned is bool)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    function isValidScanHistory(data) {
      return ((data.keys().hasAll(['scanType', 'createdAt', 'result', 'riskLevel', 'summary'])
          && data.scanType is string && data.scanType.size() <= 50
          && data.createdAt is string
          && data.result is string && data.result.size() <= 200
          && data.riskLevel is string && data.riskLevel.size() <= 50
          && data.summary is string && data.summary.size() <= 10000)
        || (data.keys().hasAll(['type', 'createdAt', 'riskLevel', 'summary'])
          && data.type is string && data.type.size() <= 50
          && data.createdAt is string
          && data.riskLevel is string && data.riskLevel.size() <= 50
          && data.summary is string && data.summary.size() <= 10000));
    }

    // User profile root document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // PII protection: users collection cannot be listed
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);

      // Learning progress subcollection
      match /learning/{docId} {
        allow get: if isValidId(userId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId) && isValidLearningProgress(incoming());
        allow delete: if isValidId(userId) && isOwner(userId);
      }

      // Scan history subcollection
      match /scanHistory/{scanId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && isValidScanHistory(incoming());
        allow update: if isValidId(userId) && isOwner(userId) && isValidScanHistory(incoming());
        allow delete: if isValidId(userId) && isOwner(userId);
      }
    }
  }
}
